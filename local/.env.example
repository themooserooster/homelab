# Example environment file for the local node.
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored — never commit it.

# UID/GID used for container volume permissions.
UID=$(id -u)
GID=$(id -g)

# Your base domain. Used for nginx server names, cert paths, and app URLs.
# The TLS scripts request a cert for this domain and its wildcard.
DOMAIN=example.com

# Pi-hole web UI password (http://<home-node-ip>:8083/admin).
PIHOLE_PASSWORD=change-me
