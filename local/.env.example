# Example environment file for the local node.
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#   chmod 600 .env   # holds secrets; /opt checkouts are world-readable
#
# .env is gitignored — never commit it.

# Your base domain. Used for nginx server names, cert paths, and app URLs.
# The TLS scripts request a cert for this domain and its wildcard.
DOMAIN=example.com

# The home node's static IP on the LAN. Pi-hole's DNS listener (port 53)
# binds to it.
LAN_IP=192.168.1.166

# Timezone for containers that honor TZ (Pi-hole).
TZ=America/Chicago

# Pi-hole web UI password (https://dns.<DOMAIN>/admin).
PIHOLE_PASSWORD=change-me
